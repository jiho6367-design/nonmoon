{
  "name": "nonmoon-personal-improvement",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env api/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "verify": "npm test && npm run build && npm run test:e2e",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format:check": "prettier --check api client scripts tests package.json playwright.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "express": "5.3.0",
    "multer": "2.4.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "vite": "7.3.7"
  }
}
